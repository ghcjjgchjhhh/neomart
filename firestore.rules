rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for products
    match /products/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow public read for categories
    match /categories/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow public read for locations
    match /locations/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Authenticated users can manage their own profile
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    match /customerStates/{email} {
      allow read, write: if request.auth != null;
    }
    
    // Authenticated users can view and create orders
    match /orders/{orderId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /inventory/{productId} {
      allow read, write: if request.auth != null;
    }

    match /orderLocations/{orderId} {
      allow read, write: if request.auth != null;
    }
    
    // Authenticated users can manage their cart
    match /carts/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Authenticated users can manage reviews
    match /reviews/{document=**} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
  }
}
